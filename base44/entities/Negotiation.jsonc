{
  "name": "Negotiation",
  "type": "object",
  "properties": {
    "item_id": {
      "type": "string",
      "description": "Reference to the target Item (the listing being requested)"
    },
    "item_title": {
      "type": "string",
      "description": "Target item title (denormalized)"
    },
    "offerer_id": {
      "type": "string",
      "description": "Target listing owner user ID"
    },
    "offerer_name": {
      "type": "string",
      "description": "Target listing owner name"
    },
    "bidder_id": {
      "type": "string",
      "description": "Requester user ID (person offering their listing in exchange)"
    },
    "bidder_name": {
      "type": "string",
      "description": "Requester name"
    },
    "initial_offer_hours": {
      "type": "number",
      "description": "Initial hours offered by bidder"
    },
    "counter_offer_hours": {
      "type": "number",
      "description": "Counter-offer hours"
    },
    "agreed_hours": {
      "type": "number",
      "description": "Final agreed hours"
    },
    "work_type": {
      "type": "string",
      "description": "Type of work being offered"
    },
    "offered_listing_id": {
      "type": "string",
      "description": "Requester's own listing offered in exchange (an Item record of either listing type)"
    },
    "offered_listing_title": {
      "type": "string",
      "description": "Requester's offered listing title (denormalized)"
    },
    "offered_listing_type": {
      "type": "string",
      "enum": [
        "item",
        "service"
      ],
      "description": "Type of the requester's offered listing (snapshot at negotiation start)"
    },
    "target_listing_type": {
      "type": "string",
      "enum": [
        "item",
        "service"
      ],
      "description": "Type of the target listing (snapshot at negotiation start)"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "none",
        "pending"
      ],
      "default": "none",
      "description": "'pending' when the listing owner changed return preferences and this active negotiation is paused for review"
    },
    "review_confirmed_offerer": {
      "type": "boolean",
      "default": false,
      "description": "Listing owner confirmed continuing after a preference change"
    },
    "review_confirmed_bidder": {
      "type": "boolean",
      "default": false,
      "description": "Requester confirmed continuing after a preference change"
    },
    "review_note": {
      "type": "string",
      "description": "Summary of the owner's updated return preferences when paused for review"
    },
    "location": {
      "type": "string",
      "description": "Where work will be performed"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "When work should be completed"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes or requirements"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "accepted",
        "declined",
        "expired",
        "converted",
        "closed"
      ],
      "default": "active",
      "description": "Negotiation status"
    },
    "current_offer_by": {
      "type": "string",
      "description": "User ID who made the current offer"
    },
    "offer_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "offered_by": {
            "type": "string"
          },
          "offered_by_name": {
            "type": "string"
          },
          "hours": {
            "type": "number"
          },
          "work_type": {
            "type": "string"
          },
          "message": {
            "type": "string",
            "description": "Optional message accompanying the offer"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "default": [],
      "description": "History of all offers made"
    },
    "last_activity": {
      "type": "string",
      "format": "date-time",
      "description": "Last message or offer timestamp"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Auto-expire if inactive (48h from last activity)"
    }
  },
  "required": [
    "item_id",
    "offerer_id",
    "bidder_id",
    "initial_offer_hours"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.offerer_id": "{{user.id}}"
        },
        {
          "data.bidder_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.offerer_id": "{{user.id}}"
        },
        {
          "data.bidder_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.offerer_id": "{{user.id}}"
        },
        {
          "data.bidder_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.offerer_id": "{{user.id}}"
        },
        {
          "data.bidder_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}