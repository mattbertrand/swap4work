{
  "name": "PhoneVerification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User whose phone number was confirmed"
    },
    "phone": {
      "type": "string",
      "description": "Confirmed phone number in E.164 format"
    },
    "verified_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the phone number was confirmed"
    }
  },
  "required": [
    "user_id",
    "phone"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}