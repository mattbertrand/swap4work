{
  "name": "ModerationStatus",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User this moderation record applies to"
    },
    "is_banned": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user is banned"
    },
    "is_suspended": {
      "type": "boolean",
      "default": false,
      "description": "Whether the user is suspended"
    },
    "suspension_end_date": {
      "type": "string",
      "description": "When the suspension ends (if suspended)"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}