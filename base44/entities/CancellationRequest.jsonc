{
  "name": "CancellationRequest",
  "type": "object",
  "properties": {
    "agreement_id": {
      "type": "string",
      "description": "Agreement the cancellation request belongs to"
    },
    "requested_by": {
      "type": "string",
      "description": "User ID who requested the cancellation (server-attested from the session)"
    },
    "requested_by_name": {
      "type": "string",
      "description": "Requester name (denormalized)"
    },
    "reason": {
      "type": "string",
      "description": "Reason for the cancellation"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Request status"
    },
    "requested_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the request was recorded"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the request expires (48 hours after recording)"
    }
  },
  "required": [
    "agreement_id",
    "requested_by",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}