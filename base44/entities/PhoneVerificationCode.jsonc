{
  "name": "PhoneVerificationCode",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User ID the code was sent to"
    },
    "phone": {
      "type": "string",
      "description": "Phone number being verified"
    },
    "code": {
      "type": "string",
      "description": "6-digit verification code"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the code expires"
    },
    "used": {
      "type": "boolean",
      "default": false,
      "description": "Whether the code has been used or invalidated"
    },
    "failed_attempts": {
      "type": "integer",
      "default": 0,
      "description": "Number of incorrect verification attempts on this code"
    }
  },
  "required": [
    "user_id",
    "phone",
    "code",
    "expires_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}