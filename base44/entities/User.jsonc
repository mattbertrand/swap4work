{
  "name": "User",
  "type": "object",
  "properties": {
    "language": {
      "type": "string",
      "enum": [
        "en",
        "es"
      ],
      "description": "Preferred interface language (English or Spanish)"
    },
    "phone": {
      "type": "string",
      "description": "Phone number for verification"
    },
    "location": {
      "type": "string",
      "description": "City/zip code for local matching"
    },
    "latitude": {
      "type": "number",
      "description": "Location latitude for distance calculations"
    },
    "longitude": {
      "type": "number",
      "description": "Location longitude for distance calculations"
    },
    "exchange_areas": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Optional extra 'City, ST' areas where the user is willing to exchange items or provide services (self-reported availability, not residences)"
    },
    "bio": {
      "type": "string",
      "description": "Short bio about the user"
    },
    "skills": {
      "type": "string",
      "description": "Skills and interests (comma separated)"
    },
    "photo_url": {
      "type": "string",
      "description": "Profile photo URL"
    },
    "phone_verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether user has verified their phone"
    },
    "rating": {
      "type": "number",
      "default": 0,
      "description": "Average rating (0-5)"
    },
    "total_ratings": {
      "type": "integer",
      "default": 0,
      "description": "Total number of ratings received"
    },
    "hours_completed": {
      "type": "number",
      "default": 0,
      "description": "Total hours worked/received in completed agreements"
    },
    "completed_trades": {
      "type": "integer",
      "default": 0,
      "description": "Total number of completed agreements"
    },
    "user_role": {
      "type": "string",
      "enum": [
        "worker",
        "offerer",
        "both",
        "admin"
      ],
      "default": "both",
      "description": "Primary role in the platform"
    },
    "trading_interests": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Item categories this user is interested in trading for (offerer role)"
    },
    "profile_completed": {
      "type": "boolean",
      "default": false,
      "description": "Whether user has completed their profile setup"
    },
    "karma_points": {
      "type": "integer",
      "default": 0,
      "description": "Trust and reliability score"
    },
    "is_suspended": {
      "type": "boolean",
      "default": false,
      "description": "Whether user is temporarily suspended"
    },
    "suspension_end_date": {
      "type": "string",
      "format": "date",
      "description": "Date when suspension ends"
    },
    "is_banned": {
      "type": "boolean",
      "default": false,
      "description": "Whether user is permanently banned"
    },
    "cancellation_count": {
      "type": "integer",
      "default": 0,
      "description": "Number of mid-agreement cancellations"
    }
  },
  "required": []
}