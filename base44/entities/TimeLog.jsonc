{
  "name": "TimeLog",
  "type": "object",
  "properties": {
    "agreement_id": {
      "type": "string",
      "description": "Reference to Agreement"
    },
    "worker_id": {
      "type": "string",
      "description": "User ID of worker logging time"
    },
    "hours": {
      "type": "number",
      "description": "Hours worked in this entry"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date of work"
    },
    "description": {
      "type": "string",
      "description": "What was accomplished"
    },
    "milestone_id": {
      "type": "string",
      "description": "Associated milestone (optional)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "disputed"
      ],
      "default": "pending",
      "description": "Verification status"
    }
  },
  "required": [
    "agreement_id",
    "worker_id",
    "hours",
    "date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.worker_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.worker_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.worker_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.worker_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}